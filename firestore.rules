rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Katalog publik: boleh dibaca semua orang, tulis hanya user login.
    // TODO: picksakan ke custom claim admin setelah Firebase Auth dipasang:
    //   allow write: if request.auth.token.admin == true;
    match /projects/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }
    match /school_projects/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }
    match /achievements/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Form kontak: siapa pun boleh membuat 1 pesan tervalidasi, tidak bisa baca/list/hapus.
    match /contacts/{docId} {
      allow read, update, delete: if isSignedIn();
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message']) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        request.resource.data.subject is string &&
        request.resource.data.message is string &&
        request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100 &&
        request.resource.data.email.size() >= 5 && request.resource.data.email.size() <= 254 &&
        request.resource.data.subject.size() >= 3 && request.resource.data.subject.size() <= 150 &&
        request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 5000;
    }
  }
}
